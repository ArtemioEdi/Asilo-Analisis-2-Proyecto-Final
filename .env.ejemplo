# Plantilla de configuracion del asilo Cabeza de Algodon.
#
# Copie este archivo como .env y complete los valores. El .env NO se versiona:
# cada instalacion tiene su propio secreto.
#
#   cp .env.ejemplo .env
#   for v in GATEWAY_SECRETO BD_CLAVE_ROOT BD_CLAVE_VIGIA BD_CLAVE_PASTILLERO \
#            BD_CLAVE_CAJA BD_CLAVE_CONSULTAS; do
#     sed -i "s|^$v=$|$v=$(openssl rand -hex 24)|" .env
#   done
#
# Sin GATEWAY_SECRETO no arranca nada: no hay valor por defecto en el codigo, a
# proposito. Un secreto de ejemplo que se queda en produccion es un secreto
# publicado.
GATEWAY_SECRETO=

# Duracion de la sesion que firma ms-gateway.
GATEWAY_DURACION_SESION=8h

# Unico origen al que ms-gateway le responde peticiones del navegador.
ORIGEN_PERMITIDO=http://localhost:8090

# Imprimir las credenciales de demostracion en la pantalla de acceso.
# 0 = apagado, y es como debe quedar.
# 1 = las claves salen escritas en el login. Sirve para grabar el video, pero
#     las deja a la vista de cualquiera que abra la pagina.
MOSTRAR_USUARIOS_DEMO=0

# Base de datos MySQL. Una clave por usuario de servicio:
#   BD_CLAVE_ROOT        root del motor
#   BD_CLAVE_VIGIA       usr_vigia       (base asilo_vigia)
#   BD_CLAVE_PASTILLERO  usr_pastillero  (base asilo_pastillero)
#   BD_CLAVE_CAJA        usr_caja        (base asilo_caja)
#   BD_CLAVE_CONSULTAS   usr_consultas   (base asilo_consultas)
#
# Las lee sql/01-bases-y-usuarios.sh cuando MySQL arranca por primera vez.
# Ningun archivo versionado las contiene.
#
# OJO: los usuarios se crean UNA SOLA VEZ, con el volumen de datos vacio. Si
# cambia una clave despues hay que recrear el volumen para que surta efecto:
#   docker compose down -v && docker compose up -d
BD_CLAVE_ROOT=
BD_CLAVE_VIGIA=
BD_CLAVE_PASTILLERO=
BD_CLAVE_CAJA=
BD_CLAVE_CONSULTAS=

# Correo al familiar responsable (ms-consultas). TODAS OPCIONALES: si
# SMTP_HOST queda vacio el aviso no se envia, pero tampoco se pierde. Queda en
# la bitacora del contenedor y en la tabla correos_enviados con estado
# REGISTRADO, y la estacion lo muestra en la vista del medico.
#
# Para enviar de verdad, complete los cinco. Con Gmail hace falta una clave de
# aplicacion, no la clave de la cuenta.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DE=asilo@cabezadealgodon.local
