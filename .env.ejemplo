# ---------------------------------------------------------------------------
# Plantilla de configuracion del asilo Cabeza de Algodon.
#
# Copie este archivo como .env y complete el valor. El archivo .env NO se
# versiona (esta en .gitignore): cada instalacion tiene su propio secreto.
#
#   cp .env.ejemplo .env
#
# Genere el secreto con:
#
#   openssl rand -hex 32
#
# Sin GATEWAY_SECRETO ni el gateway ni los microservicios arrancan: no existe
# un valor por defecto en el codigo, a proposito. Un secreto de ejemplo que se
# queda en produccion es un secreto publicado.
# ---------------------------------------------------------------------------
GATEWAY_SECRETO=

# Duracion de la sesion que firma ms-gateway.
GATEWAY_DURACION_SESION=8h

# Unico origen al que ms-gateway le responde peticiones del navegador.
ORIGEN_PERMITIDO=http://localhost:8090
