# ---------------------------------------------------------------------------
# Plantilla de configuracion del asilo Cabeza de Algodon.
#
# Copie este archivo como .env y complete el valor. El archivo .env NO se
# versiona (esta en .gitignore): cada instalacion tiene su propio secreto.
#
#   cp .env.ejemplo .env
#
# Genere el secreto con:
#
#   openssl rand -hex 32
#
# Para llenar de una sola vez este archivo y las cuatro claves de MySQL:
#
#   cp .env.ejemplo .env
#   for v in GATEWAY_SECRETO BD_CLAVE_ROOT BD_CLAVE_VIGIA BD_CLAVE_PASTILLERO BD_CLAVE_CAJA; do
#     sed -i "s|^$v=$|$v=$(openssl rand -hex 24)|" .env
#   done
#
# Sin GATEWAY_SECRETO ni el gateway ni los microservicios arrancan: no existe
# un valor por defecto en el codigo, a proposito. Un secreto de ejemplo que se
# queda en produccion es un secreto publicado.
# ---------------------------------------------------------------------------
GATEWAY_SECRETO=

# Duracion de la sesion que firma ms-gateway.
GATEWAY_DURACION_SESION=8h

# Unico origen al que ms-gateway le responde peticiones del navegador.
ORIGEN_PERMITIDO=http://localhost:8090

# Imprimir las credenciales de demostracion en la pantalla de acceso.
# 0 = apagado (valor por defecto y el que debe quedar).
# 1 = las tres claves salen escritas en el login. Sirve para grabar el video
#     de la entrega; deja las credenciales a la vista de cualquiera que abra
#     la pagina, asi que no se deja encendido.
MOSTRAR_USUARIOS_DEMO=0

# ---------------------------------------------------------------------------
# Base de datos MySQL.
#
# Las cuatro claves las usa el contenedor bd-asilo:
#   BD_CLAVE_ROOT        clave del usuario root de MySQL
#   BD_CLAVE_VIGIA       clave de usr_vigia       (base asilo_vigia)
#   BD_CLAVE_PASTILLERO  clave de usr_pastillero  (base asilo_pastillero)
#   BD_CLAVE_CAJA        clave de usr_caja        (base asilo_caja)
#
# Las lee sql/01-bases-y-usuarios.sh cuando MySQL arranca por primera vez y
# crea los tres usuarios. Ningun archivo versionado las contiene.
#
# OJO: los usuarios se crean UNA SOLA VEZ, cuando el volumen de datos esta
# vacio. Si cambia una clave despues, hay que recrear el volumen para que
# surta efecto:  docker compose down -v && docker compose up -d
# ---------------------------------------------------------------------------
BD_CLAVE_ROOT=
BD_CLAVE_VIGIA=
BD_CLAVE_PASTILLERO=
BD_CLAVE_CAJA=
